# Copy to agent.env, fill in, chmod 600. Never commit agent.env.
# docker --env-file does not strip trailing comments, so every comment is on its own line.

# What to watch. The skill is a directory in this repository; nothing else is mounted.
GITHUB_REPO=owner/repository
SKILL=skills/review
# Required check name; the agent appends /pr-<number>.
STATUS_CONTEXT=review

# GitHub token with Contents: read,
# Pull requests: write, Commit statuses: write. Reviews are posted as this identity,
# so use a reviewer distinct from the PR authors.
GITHUB_TOKEN=

# Codex uses your ChatGPT sign-in: run "login" once, or just start and follow the link in the logs.
MODEL=gpt-6-sol
FAST_MODE=false

# Defaults shown; uncomment to change.
# Non-draft PRs into these branches are reviewed.
# TARGET_BRANCHES=main
# Parallel reviews, one Codex sign-in each (/data/codex, /data/codex-2, ...).
# MAX_CONCURRENCY=1
# Attempts per head commit, including the first.
# MAX_ATTEMPTS=3
# Discovery interval in seconds.
# POLL_SECONDS=15
# Also review PRs already open on the first scan.
# RUN_EXISTING=false
# Review new head commits on already-reviewed PRs.
# WATCH_UPDATES=true
# Maximum duration of one Codex run.
# TASK_TIMEOUT_SECONDS=1800

# Advanced watcher settings. Keep persistent paths inside the mounted /data volume.
# SANDBOX=container
# ALLOW_NETWORK=false
# DATA_DIR=/data
# CODEX_HOME=/data/codex
# CODEX_BIN=codex
